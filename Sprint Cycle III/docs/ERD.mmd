erDiagram
    account {
        bigint account_id PK
        text name
        text email
        text role
        text status
        text discipline
        boolean open_to_commissions
        text password_hash
        text bio
        timestamp_with_time_zone created_at
    }
    account_restriction {
        bigint restriction_id PK
        bigint user_report_id FK
        bigint moderator_id FK
        text moderator_role FK
        text action_type
        timestamp_with_time_zone recorded_at
        timestamp_with_time_zone expires_at
        text notes
    }
    analytics_report {
        bigint report_id PK
        bigint administrator_id FK
        text administrator_role FK
        text report_type
        date date_from
        date date_to
        timestamp_with_time_zone generated_at
        text result_summary
    }
    category {
        bigint category_id PK
        text name
        text kind
    }
    comment {
        bigint comment_id PK
        bigint work_id FK
        bigint author_id FK
        text body
        text gif_url
        timestamp_with_time_zone created_at
        text visibility
    }
    comment_report {
        bigint comment_report_id PK
        bigint comment_id FK
        bigint reporter_id FK
        text reason
        timestamp_with_time_zone reported_at
    }
    conversation {
        bigint conversation_id PK
        text subject
        bigint created_by FK
        timestamp_with_time_zone created_at
    }
    conversation_member {
        bigint conversation_id PK,FK
        bigint account_id PK,FK
        timestamp_with_time_zone joined_at
        timestamp_with_time_zone last_read_at
    }
    creative_work {
        bigint work_id PK
        bigint creator_id FK
        text creator_role FK
        text title
        text media_type
        text description
        text soundcloud_url
        boolean featured
        boolean archived
        timestamp_with_time_zone published_at
        text content_text
        text visibility
    }
    feedback_reply {
        bigint reply_id PK
        bigint feedback_id FK
        bigint creator_id FK
        text reply_text
        timestamp_with_time_zone replied_at
    }
    follow {
        bigint follow_id PK
        bigint follower_id FK
        bigint creator_id FK
        text creator_role FK
        timestamp_with_time_zone followed_at
    }
    help_ticket {
        bigint ticket_id PK
        bigint account_id FK
        text subject
        text body
        text status
        timestamp_with_time_zone opened_at
        bigint assigned_to FK
        text response
        timestamp_with_time_zone resolved_at
    }
    invitation {
        bigint invitation_id PK
        bigint opportunity_id FK
        bigint creator_id FK
        text creator_role FK
        text status
        timestamp_with_time_zone invited_at
        timestamp_with_time_zone responded_at
    }
    mentor_feedback {
        bigint feedback_id PK
        bigint work_id FK
        bigint mentor_id FK
        bigint request_id FK
        text request_status FK
        text strengths
        text improvements
        text recommendation
        timestamp_with_time_zone written_at
    }
    moderation_case {
        bigint case_id PK
        bigint report_id FK
        bigint comment_report_id FK
        bigint moderator_id FK
        text moderator_role FK
        text findings
        text action_taken
        text status
        timestamp_with_time_zone recorded_at
        text escalation_reason
    }
    nomination {
        bigint nomination_id PK
        bigint mentor_id FK
        text mentor_role FK
        bigint work_id FK
        bigint moderator_id FK
        text moderator_role FK
        text reason
        text status
        timestamp_with_time_zone nominated_at
        timestamp_with_time_zone decided_at
    }
    notification {
        bigint notification_id PK
        bigint account_id FK
        text kind
        text body
        bigint work_id FK
        timestamp_with_time_zone read_at
        timestamp_with_time_zone created_at
    }
    opportunity {
        bigint opportunity_id PK
        bigint scout_id FK
        text scout_role FK
        text title
        date starts_on
        date ends_on
        text description
    }
    platform_setting {
        bigint setting_id PK
        text name
        text value
        timestamp_with_time_zone updated_at
        bigint updated_by FK
        text administrator_role FK
    }
    private_message {
        bigint message_id PK
        bigint conversation_id FK
        bigint sender_id FK
        text body
        timestamp_with_time_zone sent_at
    }
    review_request {
        bigint request_id PK
        bigint creator_id FK
        bigint mentor_id FK
        text mentor_role FK
        bigint work_id FK
        text note
        text status
        timestamp_with_time_zone requested_at
    }
    role_application {
        bigint application_id PK
        bigint administrator_id FK
        text administrator_role FK
        text applicant_name
        text email
        text requested_role FK
        text statement
        text status
        timestamp_with_time_zone submitted_at
        timestamp_with_time_zone decided_at
        bigint approved_account_id FK
    }
    saved_work {
        bigint save_id PK
        bigint account_id FK
        bigint work_id FK
        timestamp_with_time_zone saved_at
    }
    scout_candidate {
        bigint candidate_id PK
        bigint scout_id FK
        text scout_role FK
        bigint creator_id FK
        text creator_role FK
        text notes
        timestamp_with_time_zone saved_at
    }
    scout_message {
        bigint message_id PK
        bigint scout_id FK
        text scout_role FK
        bigint creator_id FK
        text creator_role FK
        text body
        timestamp_with_time_zone sent_at
        bigint conversation_id FK
    }
    status_change {
        bigint change_id PK
        bigint administrator_id FK
        text administrator_role FK
        bigint account_id FK
        text old_status
        text new_status
        timestamp_with_time_zone changed_at
        text reason
    }
    user_report {
        bigint user_report_id PK
        bigint account_id FK
        text reason
        timestamp_with_time_zone reported_at
        bigint reporter_id FK
    }
    work_category {
        bigint work_id PK,FK
        bigint category_id PK,FK
    }
    work_media {
        bigint media_id PK
        bigint work_id FK
        text asset_url
        text alt_text
        integer position
    }
    work_report {
        bigint report_id PK
        bigint work_id FK
        text reason
        text reporter_name
        timestamp_with_time_zone reported_at
        bigint reporter_id FK
        text reason_type
    }
    user_report ||--o{ account_restriction : "user_report_id"
